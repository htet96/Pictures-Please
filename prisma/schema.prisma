generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Gallery {
  id              String      @id @default(cuid())
  name            String
  slug            String      @unique
  description     String?
  displayMode     DisplayMode @default(MASONRY)
  password        String?
  requireApproval Boolean     @default(true)
  allowUserDelete Boolean     @default(false)
  allowUserUpload Boolean     @default(true)
  isPublic        Boolean     @default(true)
  allowWishes     Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  photos          Photo[]
  wishes          Wish[]
}

model Photo {
  id            String      @id @default(cuid())
  galleryId     String
  gallery       Gallery     @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  originalPath  String
  thumbnailPath String
  filename      String
  mimeType      String
  width         Int
  height        Int
  sizeBytes     Int
  status        PhotoStatus @default(PENDING)
  uploaderIp    String?
  uploaderName  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([galleryId, status])
  @@index([status])
}

model GlobalSettings {
  id                     String  @id @default("singleton")
  allowUserGalleries     Boolean @default(false)
  defaultRequireApproval Boolean @default(true)
  defaultAllowUserDelete Boolean @default(false)
  slideshowSpeed         Int     @default(4000)
  slideshowTransition    String  @default("fade")
  transitionDuration     Int     @default(500)
  adminPasswordOnly      Boolean @default(false)
  watermarkEnabled       Boolean @default(true)
  watermarkType          String  @default("text")
  watermarkText          String  @default("PICTURES")
  watermarkImagePath     String?
  watermarkOpacity       Int     @default(4)
  watermarkX             Int     @default(5)
  watermarkY             Int     @default(50)
  watermarkRotation      Int     @default(-90)
  watermarkSize          Int     @default(11)
  linksPublic            Boolean @default(true)
  backgroundTheme        String  @default("ember")
  backgroundAnimation    String  @default("drift")
  backgroundSpeed        Int     @default(3)
}

model Wish {
  id         String   @id @default(cuid())
  galleryId  String
  gallery    Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  guestToken String
  guestName  String
  message    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([galleryId])
}

model OutgoingLink {
  id    String @id @default(cuid())
  label String
  url   String
  order Int    @default(0)
}

enum DisplayMode {
  MASONRY
  GRID
  SLIDESHOW
  CAROUSEL
}

enum PhotoStatus {
  PENDING
  APPROVED
  REJECTED
}
