generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Gallery {
  id              String      @id @default(cuid())
  name            String
  slug            String      @unique
  description     String?
  displayMode     DisplayMode @default(MASONRY)
  password        String?
  requireApproval Boolean     @default(true)
  allowUserDelete Boolean     @default(false)
  allowUserUpload Boolean     @default(true)
  isPublic        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  photos          Photo[]
}

model Photo {
  id            String      @id @default(cuid())
  galleryId     String
  gallery       Gallery     @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  originalPath  String
  thumbnailPath String
  filename      String
  mimeType      String
  width         Int
  height        Int
  sizeBytes     Int
  status        PhotoStatus @default(PENDING)
  uploaderIp    String?
  uploaderName  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([galleryId, status])
  @@index([status])
}

model GlobalSettings {
  id                     String  @id @default("singleton")
  allowUserGalleries     Boolean @default(false)
  defaultRequireApproval Boolean @default(true)
  defaultAllowUserDelete Boolean @default(false)
}

enum DisplayMode {
  MASONRY
  GRID
  SLIDESHOW
  CAROUSEL
}

enum PhotoStatus {
  PENDING
  APPROVED
  REJECTED
}
